{
  "version": 2,
  "builds": [
    {
      "src": "assetmanagement/assetmanager/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "assetmanagement/assetmanager/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "assetmanager.settings",
    "PYTHONPATH": "$PYTHONPATH:/var/task/assetmanagement",
    "VERCEL": "1",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "FagiAssets2024!",
    "ADMIN_EMAIL": "admin@fagiassets.com"
  },
  "functions": {
    "assetmanagement/assetmanager/wsgi.py": {
      "includeFiles": "assetmanagement/**"
    }
  },
  "github": {
    "autoJobCancelation": false
  }
}